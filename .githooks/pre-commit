#!/bin/sh
# Every commit carries its own drawing of the architecture, and keeps the
# "code metrics must not rise" rule. See AGENTS.md for both.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Bypass in a true emergency with `git commit --no-verify` (discouraged).

python3 scripts/architecture.py >/dev/null || exit 1
git add docs/architecture.md docs/architecture.html

python3 scripts/code_metrics.py --check
status=$?
if [ "$status" -ne 0 ]; then
    echo ""
    echo "Pre-commit blocked by code-metrics guard." 1>&2
fi
exit "$status"
